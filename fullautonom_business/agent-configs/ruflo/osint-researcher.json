  "model": "gemini-2.5-pro",
  "provider": "qoder",
  "endpoint": "https://qoder.ai/api/v1",
  "inputEvents": ["events/osint.request", "events/bi.osint"],
  "outputEvents": ["events/osint.response", "events/osint.trend.discovered"],
  "redisChannel": "fo-business:osint",
