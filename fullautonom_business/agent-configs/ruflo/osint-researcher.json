{
  "name": "osint-researcher",
  "framework": "ruflo",
  "role": "OSINT Trend-Scanner & Research Agent",
  "description": "Echtzeit-Recherche, Trend-Scanning, Competitor-Analyse für Festival/DJ-Bekleidung",
