{
  "name": "@wawi/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=drizzle.config.cjs",
    "db:push": "drizzle-kit push --config=drizzle.config.cjs"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/csrf-protection": "^6.4.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "argon2": "^0.41.0",
    "bullmq": "^6.3.4",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "fastify": "^4.28.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "postgres": "^3.4.4",
    "uuid": "^14.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/argon2": "^0.14.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.14.10",
    "@types/sax": "^1.2.7",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.24.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
